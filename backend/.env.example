# Application
APP_NAME="Cupcake"
APP_ENV="development"
APP_PORT=4000
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"

# Database
MONGODB_URI="mongodb://localhost:27017/cupcake"

# Authentication
JWT_ACCESS_SECRET="replace-me-access-secret"
JWT_REFRESH_SECRET="replace-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Default super admin (created by seeders)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@cupcake.local"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Demo tenant and client admin (created by seeders)
DEMO_CLIENT_NAME="Demo Client"
DEMO_CLIENT_EMAIL="client@cupcake.local"
DEMO_CLIENT_PASSWORD="ChangeMe123!"
DEMO_TENANT_NAME="Demo Company"

# Sending channels. Supported values:
#   EMAIL_PROVIDER:    mock | sendgrid
#   SMS_PROVIDER:      mock | twilio
#   WHATSAPP_PROVIDER: mock | twilio
EMAIL_PROVIDER="mock"
SMS_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"

# Twilio credentials. Required when SMS_PROVIDER=twilio or
# WHATSAPP_PROVIDER=twilio. Provide either TWILIO_MESSAGING_SERVICE_SID or a
# channel-specific From number (TWILIO_SMS_FROM and/or TWILIO_WHATSAPP_FROM).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM="whatsapp:+10000000000"
TWILIO_STATUS_CALLBACK_URL=""

# Twilio SendGrid email credentials. Required when EMAIL_PROVIDER=sendgrid.
TWILIO_SENDGRID_API_KEY=""
TWILIO_SENDGRID_FROM_EMAIL="no-reply@cupcake.local"
TWILIO_SENDGRID_FROM_NAME="Cupcake"
TWILIO_SENDGRID_EVENT_WEBHOOK_SECRET=""
UNSUBSCRIBE_TOKEN_SECRET=""

# Token wallet / billing. Tokens are internal prepaid credits used for
# email, SMS, and WhatsApp sends. TOKEN_PURCHASE_MODE=manual keeps the
# purchase flow in a pending state until a super admin approves it.
# TOKEN_FAILED_SEND_POLICY controls what happens after a provider failure
# (refund | charge | hold).
TOKEN_PURCHASE_MODE="manual"
DEFAULT_TOKEN_BALANCE=0
DEFAULT_EMAIL_TOKEN_COST=1
DEFAULT_SMS_TOKEN_COST=2
DEFAULT_WHATSAPP_TOKEN_COST=3
TOKEN_FAILED_SEND_POLICY="refund"

# Mercado Pago online payments. PAYMENT_PROVIDER=mercadopago wires the real
# Checkout Pro + Subscriptions flow and requires the public key and access
# token. PAYMENT_PROVIDER=mock keeps the flow self-contained for local
# development and tests and never contacts the Mercado Pago API.
PAYMENT_PROVIDER="mock"
MERCADOPAGO_ENV="sandbox"
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_SUCCESS_URL="http://localhost:5173/billing/payment/success"
MERCADOPAGO_FAILURE_URL="http://localhost:5173/billing/payment/failure"
MERCADOPAGO_PENDING_URL="http://localhost:5173/billing/payment/pending"
MERCADOPAGO_NOTIFICATION_URL="http://localhost:4000/api/v1/webhooks/mercadopago"
MERCADOPAGO_STATEMENT_DESCRIPTOR="CUPCAKE"
PAYMENT_REMINDER_DAYS_BEFORE=3
LOW_TOKEN_BALANCE_THRESHOLD=100

# Media storage. Local is for development only; production must use S3-compatible
# object storage and can expose either public CDN URLs or signed URLs.
STORAGE_DRIVER="local"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads"
LOCAL_UPLOADS_DIR="./uploads"
MAX_IMAGE_UPLOAD_MB=5
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# CORS (comma-separated list of origins)
CORS_ORIGIN="http://localhost:5173"

# Observability
LOG_LEVEL="info"
ERROR_MONITORING_DSN=""
ERROR_MONITORING_ENVIRONMENT=""
OPERATIONS_ALERT_EMAIL=""

# HTTP hardening
REQUEST_BODY_LIMIT="100kb"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Background job queue. `memory` is a MongoDB-backed in-process queue suitable
# for local development and single-node deployments — start the worker with
# `pnpm --filter @cupcake/backend run worker`. `redis` is reserved for the
# future Redis-backed adapter and is not yet implemented; selecting it fails
# fast at startup. `inline` runs each enqueued job synchronously inside the
# enqueueing process and is intended only for the test suite.
JOB_QUEUE_DRIVER="memory"
REDIS_URL=""
JOB_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_SECONDS=30
JOB_POLL_INTERVAL_MS=500
JOB_LOCK_TIMEOUT_MS=60000

# Public form anti-abuse. PUBLIC_FORM_CAPTCHA_PROVIDER=none keeps the public
# form CAPTCHA-free (default). PUBLIC_FORM_CAPTCHA_PROVIDER=turnstile wires
# Cloudflare Turnstile and requires both site and secret keys. Per-dimension
# sliding-window limits guard the submission endpoint without affecting
# legitimate respondents — set a dimension to 0 to disable it.
PUBLIC_FORM_CAPTCHA_PROVIDER="none"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
PUBLIC_FORM_HONEYPOT_FIELD="website_url"
PUBLIC_FORM_RATE_LIMIT_PER_IP_PER_MINUTE=30
PUBLIC_FORM_RATE_LIMIT_PER_SURVEY_PER_MINUTE=120
PUBLIC_FORM_RATE_LIMIT_PER_TENANT_PER_MINUTE=600
PUBLIC_FORM_RATE_LIMIT_PER_TOKEN_PER_MINUTE=10
PUBLIC_FORM_MIN_FILL_SECONDS=0

# Outbound webhooks + tenant API keys. WEBHOOK_SIGNING_SECRET feeds the HMAC
# used to derive API key hashes; leave blank to fall back to JWT_ACCESS_SECRET
# for local development. API_KEY_DEFAULT_RATE_LIMIT_PER_MINUTE is the target
# per-key request quota; phase 32 only exposes the value (the global rate
# limiter still applies) so a later phase can enforce it.
WEBHOOK_SIGNING_SECRET=""
API_KEY_DEFAULT_RATE_LIMIT_PER_MINUTE=60
