{
  "name": "@cupcake/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cupcake backend API.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "worker": "node --env-file=.env src/worker.js",
    "worker:dev": "node --watch --env-file=.env src/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env src/seeders/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.0.1",
    "helmet": "^8.0.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.0.0",
    "mongoose": "^8.8.0",
    "multer": "^2.1.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^17.13.2",
    "globals": "^15.12.0",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.5"
  }
}
