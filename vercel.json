{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --filter @cupcake/frontend...",
  "buildCommand": "pnpm --filter @cupcake/frontend build",
  "outputDirectory": "frontend/dist",
  "rewrites": [{ "source": "/:path*", "destination": "/index.html" }]
}
